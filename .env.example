# Copy to .env and fill in. Nothing here needs a paid tier.

DATABASE_URL=postgresql+psycopg2://widget_user:widget_pass@localhost:5432/widget_platform

# Geo providers (both free, no key required, no credit card)
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/

# Rate limiting
RATE_LIMIT_PER_IP=10/minute
RATE_LIMIT_PER_WIDGET=60/minute

# Demo / testing knobs — flip these live during the demo (§13)
FORCE_GEO_PROVIDER_A_DOWN=false
FORCE_GEO_PROVIDER_B_DOWN=false
FORCE_EMAIL_FAILURE=false

# CORS
ALLOWED_ORIGINS=*
